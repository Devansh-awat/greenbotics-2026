    DC[DatasetCaptureThread<br/>1 ± 0.2 s raw JPEGs]:::worker
    CT -- get_next_frame --> SM
    ST -- get_readings --> SM
    IT -- get_heading --> SM
    SM -- submit frame+detections --> AW
    AW -- write annotated --> VW
    CT -. raw frame .-> DC

