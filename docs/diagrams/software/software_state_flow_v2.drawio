<mxfile host="app.diagrams.net" agent="Kiro">
  <diagram name="Navigation State Flow" id="state-flow-v2">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Flat Priority State Machine — Obstacle Challenge&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="15" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- STARTUP PHASE (left column) -->
        <mxCell id="start" value="" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="35" height="35" as="geometry" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;Boot&lt;/b&gt;&lt;br&gt;Init threads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="115" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dir_detect" value="&lt;b&gt;Direction Detect&lt;/b&gt;&lt;br&gt;ToF: left vs right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="115" height="45" as="geometry" />
        </mxCell>
        <mxCell id="lock_heading" value="&lt;b&gt;Lock INITIAL_HEADING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="115" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init_man" value="&lt;b&gt;Initial Maneuver&lt;/b&gt;&lt;br&gt;Exit parking pocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="115" height="45" as="geometry" />
        </mxCell>

        <!-- Startup arrows -->
        <mxCell id="a1" edge="1" source="start" target="boot" style="rounded=1;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" source="boot" target="dir_detect" style="rounded=1;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" edge="1" source="dir_detect" target="lock_heading" style="rounded=1;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" edge="1" source="lock_heading" target="init_man" style="rounded=1;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" edge="1" source="init_man" target="main_loop_box" style="rounded=1;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MAIN LOOP (center - large box) -->
        <mxCell id="main_loop_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="850" height="480" as="geometry" />
        </mxCell>
        <mxCell id="main_loop_title" value="&lt;b&gt;MAIN LOOP&lt;/b&gt; — runs every frame (~50 fps)&lt;br&gt;&lt;i&gt;Each frame: re-evaluate from scratch based on current detections&lt;/i&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Frame input -->
        <mxCell id="frame_in" value="&lt;b&gt;Get Frame&lt;/b&gt;&lt;br&gt;+ Sensors&lt;br&gt;+ Heading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="155" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="process" value="&lt;b&gt;Process Frame&lt;/b&gt;&lt;br&gt;HSV → masks → contours&lt;br&gt;→ detected blocks, walls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="235" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- Priority chain (waterfall style) -->
        <mxCell id="check_close" value="&lt;b&gt;Close block?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_close" value="&lt;b&gt;P1: EVASION&lt;/b&gt;&lt;br&gt;Reverse 0.5s&lt;br&gt;Counter-steer 0.3s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="145" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="check_block" value="&lt;b&gt;Block visible?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="250" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_block" value="&lt;b&gt;P2: TARGET-LINE&lt;/b&gt;&lt;br&gt;Angle geometry steering&lt;br&gt;+ speed reduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="155" height="55" as="geometry" />
        </mxCell>

        <mxCell id="check_closewall" value="&lt;b&gt;Wall ahead?&lt;/b&gt;&lt;br&gt;(close_black &gt; 3000)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="350" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="act_closewall" value="&lt;b&gt;CORNER TURN&lt;/b&gt;&lt;br&gt;Force +/-35 deg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="355" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="act_wall" value="&lt;b&gt;P3: WALL FOLLOW&lt;/b&gt;&lt;br&gt;PD controller&lt;br&gt;Balance left/right areas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="455" width="155" height="55" as="geometry" />
        </mxCell>

        <!-- Priority arrows -->
        <mxCell id="pa1" edge="1" source="process" target="check_close" style="rounded=1;strokeWidth=1;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa2" edge="1" source="check_close" target="act_close" style="rounded=1;strokeWidth=1;strokeColor=#b85450;" parent="1" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa3" edge="1" source="check_close" target="check_block" style="rounded=1;strokeWidth=1;" parent="1" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa4" edge="1" source="check_block" target="act_block" style="rounded=1;strokeWidth=1;strokeColor=#9673a6;" parent="1" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa5" edge="1" source="check_block" target="check_closewall" style="rounded=1;strokeWidth=1;" parent="1" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa6" edge="1" source="check_closewall" target="act_closewall" style="rounded=1;strokeWidth=1;strokeColor=#d6b656;" parent="1" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa7" edge="1" source="check_closewall" target="act_wall" style="rounded=1;strokeWidth=1;strokeColor=#82b366;" parent="1" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frame input arrows -->
        <mxCell id="fa1" edge="1" source="frame_in" target="process" style="rounded=1;strokeWidth=1;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Turn counter check (bottom) -->
        <mxCell id="turn_check" value="&lt;b&gt;Turns = 13?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="490" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="turn_label" value="&lt;i&gt;Checked every frame&lt;br&gt;after orange-line count&lt;/i&gt;" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="545" width="130" height="30" as="geometry" />
        </mxCell>

        <!-- EXIT to parking -->
        <mxCell id="parking" value="&lt;b&gt;PARKING&lt;/b&gt;&lt;br&gt;6-step parallel park&lt;br&gt;(gyro + ToF + camera)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="&lt;b&gt;STOP&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="710" width="60" height="40" as="geometry" />
        </mxCell>

        <!-- Turn check arrows -->
        <mxCell id="ta1" edge="1" source="turn_check" target="parking" style="rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" parent="1" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ta2" edge="1" source="parking" target="stop" style="rounded=1;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop back arrow (No from turn check → back to top of loop) -->
        <mxCell id="loop_back" value="No → next frame" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="440" y="505" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- Annotations -->
        <mxCell id="note1" value="&lt;b&gt;Key principle:&lt;/b&gt; Each frame re-evaluates from scratch.&lt;br&gt;No hidden state between frames — current detections alone determine action." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="470" width="350" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
